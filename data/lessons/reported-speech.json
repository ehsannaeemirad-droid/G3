          "hint": "said + was."
        },
        {
          "type": "mcq",
          "tag": "backshift",
          "prompt": "Direct: 'Don't go!' → She told me ___.",
          "options": ["not to go", "to not go", "don't go"],
          "answer": 0,
          "why": "منفی → not to go.",
          "hint": "not to go."
        },
        {
          "type": "fill",
          "tag": "questions",
          "prompt": "جای خالی را پر کن:",
          "sentence": "Direct: 'Are you ready?' → She asked me ___ I was ready.",
          "answers": ["if", "whether"],
          "placeholder": "if / whether",
          "why": "سؤال بله/خیر → if یا whether.",
