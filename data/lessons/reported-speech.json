        },
        {
          "type": "fill",
          "tag": "questions",
          "prompt": "جای خالی را پر کن:",
          "sentence": "Direct: 'Where do you work?' → She asked where I ___.",
          "answers": ["worked"],
          "placeholder": "past simple",
          "why": "work → worked، بدون did.",
          "hint": "worked."
        },
        {
          "type": "double",
          "tag": "backshift",
          "prompt": "هر دو جای خالی را پر کن:",
          "template": "Direct: 'I will see you tomorrow.' → He said he {0} see me {1}.",
          "answers1": ["would"],
