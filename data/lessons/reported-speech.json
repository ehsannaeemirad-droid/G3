          "wrongWord": "told",
          "correctWord": "said",
          "why": "بدون شخص → said (نه told).",
          "hint": "بدون شخص → said."
        },
        {
          "type": "mcq",
          "tag": "backshift",
          "prompt": "Direct: 'I can swim.' → He said he ___ swim.",
          "options": ["could", "can", "will"],
          "answer": 0,
