        { "en": "I have just eaten.", "fa": "همین حالا غذا خورده‌ام.", "hl": ["have just eaten"] },
        { "en": "I have already finished.", "fa": "قبلاً تمام کرده‌ام.", "hl": ["have already finished"] },
        { "en": "I haven't finished yet.", "fa": "هنوز تمام نکرده‌ام.", "hl": ["haven't finished yet"] },
        { "en": "Have you finished yet?", "fa": "هنوز تمام کرده‌ای؟", "hl": ["finished yet"] }
      ],
      "note": "just/already قبل از main verb · yet در آخر جمله",
      "mistake": {
        "wrong": "I yet haven't finished.",
        "right": "I haven't finished yet.",
        "whyFa": "yet در آخر جمله می‌آید، نه اول."
