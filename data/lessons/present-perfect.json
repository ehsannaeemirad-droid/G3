{
  "id": "present-perfect",
  "version": 1,
  "titleEn": "Present Perfect",
  "titleFa": "حال کامل",
  "subtitleFa": "have / has + past participle",
  "track": "tense-aspect",
  "tags": ["form", "since-for", "detect"],
  "steps": [
    {
      "id": "s1",
      "kind": "teach",
      "titleFa": "ساختار",
      "intro": "have/has + past participle. برای همهٔ فاعل‌ها یکسان، فقط have/has فرق دارد.",
      "examples": [
        { "en": "I have finished.", "fa": "تمام کرده‌ام.", "hl": ["have finished"] },
        { "en": "She has left.", "fa": "رفته است.", "hl": ["has left"] },
        { "en": "They have eaten.", "fa": "غذا خورده‌اند.", "hl": ["have eaten"] },
        { "en": "We have been here.", "fa": "اینجا بوده‌ایم.", "hl": ["have been"] }
      ],
      "note": "I/you/we/they → have · he/she/it → has",
      "mistake": {
        "wrong": "She have finished.",
        "right": "She has finished.",
        "whyFa": "برای she → has."
      },
      "items": [
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "She ___ finished her work.",
          "options": ["has", "have", "is"],
          "answer": 0,
          "why": "she → has.",
          "hint": "she → has."
        },
        {
          "type": "fill",
          "tag": "form",
          "prompt": "جای خالی را پر کن:",
          "sentence": "They ___ (have) eaten lunch.",
          "answers": ["have"],
          "placeholder": "have / has",
          "why": "they → have.",
          "hint": "they → have."
        },
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "I ___ never been to Paris.",
          "options": ["have", "has", "am"],
          "answer": 0,
          "why": "فاعل I → have: I have never been.",
          "hint": "I → have."
        }
      ]
    },
    {
      "id": "s2",
      "kind": "teach",
      "titleFa": "تجربه (ever/never)",
      "intro": "تجربه در زندگی، بدون زمان مشخص. ever = آیا هرگز؟ never = هرگز.",
      "examples": [
        { "en": "I have been to Japan.", "fa": "به ژاپن رفته‌ام.", "hl": ["have been"] },
        { "en": "She has never eaten sushi.", "fa": "او هرگز سوشی نخورده.", "hl": ["has never eaten"] },
        { "en": "Have you ever met him?", "fa": "آیا هرگز او را دیده‌ای؟", "hl": ["Have you ever met"] },
        { "en": "I have never seen snow.", "fa": "هرگز برف ندیده‌ام.", "hl": ["have never seen"] }
      ],
      "note": "ever در سؤال، never در جملهٔ خبری. هر دو قبل از main verb.",
      "mistake": {
        "wrong": "I have ever been to Japan.",
        "right": "I have never been to Japan.",
        "whyFa": "در جملهٔ خبری مثبت، ever معمولاً با never جایگزین می‌شود (یا با just/already)."
      },
      "items": [
        {
          "type": "fill",
          "tag": "form",
          "prompt": "جای خالی را پر کن:",
          "sentence": "I have ___ visited London.",
          "answers": ["never"],
          "placeholder": "never / ever / yet",
          "why": "جملهٔ خبری → never.",
          "hint": "خبری → never."
        },
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "Have you ___ met him?",
          "options": ["ever", "never", "yet"],
          "answer": 0,
          "why": "سؤال → ever.",
          "hint": "سؤال → ever."
        },
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "She has ___ been to France.",
          "options": ["never", "ever", "yet"],
          "answer": 0,
          "why": "خبری → never.",
          "hint": "خبری → never."
        }
      ]
    },
    {
      "id": "s3",
      "kind": "teach",
      "titleFa": "زمان ناتمام (today/this week)",
      "intro": "دورهٔ زمانی که تمام نشده — امروز، این هفته، این ماه.",
      "examples": [
        { "en": "I have worked hard this week.", "fa": "این هفته سخت کار کرده‌ام.", "hl": ["have worked"] },
        { "en": "It has rained a lot today.", "fa": "امروز زیاد باران آمده.", "hl": ["has rained"] },
        { "en": "I haven't seen her today.", "fa": "امروز او را ندیده‌ام.", "hl": ["haven't seen"] },
        { "en": "She has called me three times this morning.", "fa": "این صبح سه بار زنگ زده.", "hl": ["has called"] }
      ],
      "note": "❌ I have seen him yesterday · ✅ I saw him yesterday — yesterday زمان مشخص تمام‌شده است.",
      "mistake": {
        "wrong": "I have seen him yesterday.",
        "right": "I saw him yesterday.",
        "whyFa": "yesterday زمان مشخص است → past simple."
      },
      "items": [
        {
          "type": "fill",
          "tag": "form",
          "prompt": "جای خالی را پر کن:",
          "sentence": "I ___ (have) seen her twice today.",
          "answers": ["have"],
          "placeholder": "have / has",
          "why": "today → present perfect. I → have.",
          "hint": "I → have."
        },
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "We ___ seen him today.",
          "options": ["haven't", "didn't", "don't"],
          "answer": 0,
          "why": "today → present perfect منفی: haven't seen.",
          "hint": "today → haven't seen."
        },
        {
          "type": "mcq",
          "tag": "detect",
          "prompt": "کدام جمله درست است؟",
          "options": ["I have seen him yesterday.", "I saw him yesterday."],
          "answer": 1,
          "why": "yesterday → past simple، نه present perfect.",
          "hint": "yesterday → past simple."
        }
      ]
    },
    {
      "id": "s4",
      "kind": "teach",
      "titleFa": "for / since",
      "intro": "for + دوره (سه سال، دو ساعت)؛ since + نقطهٔ شروع (2020، دوشنبه، بچگی).",
      "examples": [
        { "en": "I've lived here for ten years.", "fa": "ده سال است اینجا زندگی می‌کنم.", "hl": ["for ten years"] },
        { "en": "I've lived here since 2015.", "fa": "از ۲۰۱۵ اینجا زندگی می‌کنم.", "hl": ["since 2015"] },
        { "en": "She's worked here for five years.", "fa": "پنج سال است اینجا کار می‌کند.", "hl": ["for five years"] },
        { "en": "We've known each other since childhood.", "fa": "از بچگی همدیگر را می‌شناسیم.", "hl": ["since childhood"] }
      ],
      "note": "for = مدت · since = نقطه",
      "mistake": {
        "wrong": "I've lived here since ten years.",
        "right": "I've lived here for ten years.",
        "whyFa": "«ده سال» یک دوره است → for."
