      "items": [
        {
          "type": "fill",
          "tag": "since-for",
          "prompt": "جای خالی را پر کن:",
          "sentence": "I have lived here ___ 2015.",
          "answers": ["since"],
          "placeholder": "for / since",
          "why": "2015 نقطهٔ شروع است → since.",
          "hint": "نقطه → since."
        },
        {
          "type": "mcq",
          "tag": "since-for",
          "prompt": "She has worked here ___ five years.",
          "options": ["for", "since", "from"],
          "answer": 0,
          "why": "«پنج سال» یک دوره است → for.",
          "hint": "دوره → for."
        },
        {
          "type": "fill",
          "tag": "since-for",
          "prompt": "جای خالی را پر کن:",
          "sentence": "We have known each other ___ childhood.",
          "answers": ["since"],
          "placeholder": "for / since",
          "why": "childhood نقطهٔ شروع است → since.",
          "hint": "نقطه → since."
        }
      ]
    },
    {
      "id": "s5",
      "kind": "teach",
      "titleFa": "just / already / yet",
      "intro": "just = همین حالا · already = قبلاً (زودتر از انتظار) · yet = هنوز (منفی و سؤالی).",
