          "hint": "هنوز آنجاست → has gone."
        },
        {
          "type": "fill",
          "tag": "form",
          "prompt": "جای خالی را پر کن:",
          "sentence": "I have ___ to New York twice.",
          "answers": ["been"],
          "placeholder": "been / gone",
          "why": "تجربه → been.",
          "hint": "تجربه → been."
        },
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "She isn't here. She ___ home.",
          "options": ["has gone", "has been", "is going"],
          "answer": 0,
          "why": "هنوز آنجاست → has gone.",
          "hint": "هنوز آنجاست → has gone."
