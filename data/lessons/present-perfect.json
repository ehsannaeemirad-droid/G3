      "items": [
        {
          "type": "fill",
          "tag": "form",
          "prompt": "جای خالی را پر کن:",
          "sentence": "I have ___ finished — you're too late!",
          "answers": ["already"],
          "placeholder": "already / just / yet",
          "why": "قبلاً تمام شده → already.",
          "hint": "قبلاً → already."
        },
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "Have you finished ___?",
          "options": ["yet", "already", "just"],
          "answer": 0,
          "why": "سؤالی → yet.",
          "hint": "سؤالی → yet."
        },
        {
          "type": "fill",
          "tag": "form",
          "prompt": "جای خالی را پر کن:",
          "sentence": "She has ___ left the office.",
          "answers": ["just"],
          "placeholder": "just / already / yet",
          "why": "همین حالا → just.",
          "hint": "همین حالا → just."
        }
      ]
    },
    {
