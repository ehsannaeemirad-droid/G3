{
  "id": "present-perfect-continuous",
  "version": 1,
  "titleEn": "Present Perfect Continuous",
  "titleFa": "حال کامل استمراری",
  "subtitleFa": "have / has been + verb-ing",
  "track": "tense-aspect",
  "tags": ["duration", "simple-continuous", "detect"],
  "steps": [
    {
      "id": "s1",
      "kind": "teach",
      "titleFa": "ساختار",
      "intro": "have/has been + verb-ing. برای فعالیتی که از گذشته شروع شده و تا حالا ادامه دارد.",
      "examples": [
        { "en": "I have been studying for two hours.", "fa": "دو ساعت است درس می‌خوانم.", "hl": ["have been studying"] },
        { "en": "She has been working here since June.", "fa": "از ژوئن اینجا کار می‌کند.", "hl": ["has been working"] },
        { "en": "They have been waiting all morning.", "fa": "تمام صبح منتظر بوده‌اند.", "hl": ["have been waiting"] },
        { "en": "It has been raining since yesterday.", "fa": "از دیروز باران می‌بارد.", "hl": ["has been raining"] }
      ],
      "note": "have/has + been + verb-ing (سه جزء، بدون کوتاه‌سازی در نوشتار رسمی).",
      "mistake": {
        "wrong": "I have been knowing her for years.",
        "right": "I have known her for years.",
        "whyFa": "know فعل حالتی است → present perfect، نه continuous."
      },
      "items": [
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "They ___ been waiting for an hour.",
          "options": ["have", "has", "are"],
          "answer": 0,
          "why": "they → have.",
          "hint": "they → have."
        },
        {
          "type": "fill",
          "tag": "form",
          "prompt": "جای خالی را پر کن:",
          "sentence": "She ___ (have) been reading all morning.",
          "answers": ["has"],
          "placeholder": "have / has",
          "why": "she → has.",
          "hint": "she → has."
        },
        {
          "type": "mcq",
          "tag": "form",
          "prompt": "I ___ been working all day.",
          "options": ["have", "has", "am"],
          "answer": 0,
          "why": "فاعل I → have been: I have been working.",
          "hint": "I → have."
        }
      ]
    },
