      "titleFa": "ساختار مجهول",
      "intro": "در مجهول، مفعول جمله به جای فاعل می‌آید و فعل با be + past participle ساخته می‌شود.",
      "examples": [
        { "en": "The house was built in 1990.", "fa": "خانه در ۱۹۹۰ ساخته شد.", "hl": ["was built"] },
        { "en": "English is spoken here.", "fa": "اینجا انگلیسی صحبت می‌شود.", "hl": ["is spoken"] },
        { "en": "The letters have been sent.", "fa": "نامه‌ها فرستاده شده‌اند.", "hl": ["been sent"] },
        { "en": "This cake was made by my sister.", "fa": "این کیک را خواهرم درست کرده است.", "hl": ["was made"] }
      ],
      "note": "be (هم‌زمان با جمله) + past participle",
      "mistake": {
        "wrong": "The book was wrote by him.",
        "right": "The book was written by him.",
        "whyFa": "بعد از be همیشه past participle: written، نه wrote."
      },
      "items": [
        {
